--- a/src/update/UpdateManager.cpp
+++ b/src/update/UpdateManager.cpp
@@ -48,6 +48,11 @@ constexpr char kSettingDismissedVersion[] = "update/dismissedVersion";
 // manifest's self-declared `channel`, which the guarded document could change.
 constexpr bool kOffersPrereleases = false;
 
+// Snap: this snap's updates come from the Snap Store. startCheck()
+// and checksDisabledByPolicy() both read this single flag, so the backend
+// refusal and the UI notice can never say different things.
+constexpr bool kChecksDisabledByPolicy = true;
+
 constexpr char kDigestMismatchStatus[] = "artifact-digest-mismatch";
 
 constexpr char kPartialArtifactTemplate[] = "lightning-update-XXXXXX.part";
@@ -324,23 +329,20 @@ void UpdateManager::startCheck(bool automatic)
     setStatusDetail({});
     m_handoffSummary.clear();
 
-    if (m_detection.type == InstallType::Development && !m_detection.developmentCheckAllowed) {
+    // Snap: this snap's updates come from the Snap Store, not from
+    // an upstream server, so a check must never run here, under any install
+    // type or the LIGHTNING_ALLOW_DEV_UPDATE_CHECK diagnostic override.
+    // Every network fetch in this file is reached only from here down, so
+    // this single, unconditional refusal is enough to keep this build from
+    // ever contacting an outside host on its own. (kChecksDisabledByPolicy
+    // is always true here; the `if` just keeps this read from the same flag
+    // checksDisabledByPolicy() exposes to the UI, rather than a bare true.)
+    if (kChecksDisabledByPolicy) {
         failWith(QStringLiteral(
-            "This is a development build; set LIGHTNING_ALLOW_DEV_UPDATE_CHECK=1 to check "
-            "for updates. Installation stays disabled."));
+            "Updates for this snap come from the Snap Store. Use your software "
+            "centre or run 'snap refresh'."));
         return;
     }
-    if (m_trust == &m_compiledTrust && !hasUsableTrustedKey()) {
-        failWith(QStringLiteral(
-            "This build has no update signing key compiled in, so an update could not be "
-            "verified. Please update manually."));
-        return;
-    }
-
-    setState(Checking);
-    m_signatureDocument.clear();
-    m_metadataStage = 0;
-    fetchSignature();
 }
 
