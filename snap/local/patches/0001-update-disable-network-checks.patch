-    if (m_detection.type == InstallType::Development && !m_detection.developmentCheckAllowed) {
+    // Snap: this snap's updates come from the Snap Store, not from
+    // an upstream server, so a check must never run here, under any install
+    // type or the LIGHTNING_ALLOW_DEV_UPDATE_CHECK diagnostic override.
+    // Every network fetch in this file is reached only from here down, so
+    // this single, unconditional refusal is enough to keep this build from
+    // ever contacting an outside host on its own. (kChecksDisabledByPolicy
